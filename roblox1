function refreshLauncherState()
    local launchKey = (launcherKeyBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if launchKey == premiumAccessKey then
        launcherStatus.Text = "Режим: Premium"
        launcherStatus.TextColor3 = colors.friend
    elseif launchKey == "" then
        launcherStatus.Text = "Режим: Standard"
        launcherStatus.TextColor3 = colors.textDim
    else
        launcherStatus.Text = "Режим: Standard (admin отключен)"
        launcherStatus.TextColor3 = colors.accentLight
    end
end

function enforcePremiumAccess()
    if adminUnlocked then
        return
    end

    killAllEnabled = false
    killAllTarget = nil
    if killAllConnection then
        killAllConnection:Disconnect()
        killAllConnection = nil
    end

    followEnabled = false
    followTarget = nil
    if type(stopFollow) == "function" then
        stopFollow()
    end

    escapeEnabled = false
    if escapeConnection then
        escapeConnection:Disconnect()
        escapeConnection = nil
    end

    invisibleEnabled = false
    if type(updateInvisibility) == "function" then
        updateInvisibility()
    end

    turboFlyEnabled = false
    if type(updateFly) == "function" then
        updateFly()
    end
end

function startMainInterface()
    local launchKey = (launcherKeyBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    adminUnlocked = launchKey == premiumAccessKey
    launcherStarted = true
    enforcePremiumAccess()
    launcherBackdrop.Visible = false
    launcherPanel.Visible = false
    main.Visible = true
    referenceRoot.Visible = true
    topStatsFrame.Visible = uiSettings.islandEnabled
    updateOverlayWidgets()
    updateFunctions()
end

