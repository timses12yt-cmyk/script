local function isBrightColor(color)
    return (color.R * 0.299 + color.G * 0.587 + color.B * 0.114) > 0.62
end

local function readableTextColor(backgroundColor)
    if isBrightColor(backgroundColor) then
        return Color3.fromRGB(12, 11, 10)
    end
    return Color3.fromRGB(245, 239, 228)
end

local function ensureInstance(parent, className, name)
    local existing = parent:FindFirstChild(name)
    if existing and not existing:IsA(className) then
        existing:Destroy()
        existing = nil
    end

    if not existing then
        existing = Instance.new(className)
        existing.Name = name
        existing.Parent = parent
    end

    return existing
end

local function ensureCorner(target, radius)
    local corner = target:FindFirstChildOfClass("UICorner")
    if not corner then
        corner = Instance.new("UICorner")
        corner.Parent = target
    end

    corner.CornerRadius = UDim.new(0, radius)
    return corner
end

local function ensureStroke(target, name, color, thickness, transparency)
    local stroke = ensureInstance(target, "UIStroke", name)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color
    stroke.Thickness = thickness
    stroke.Transparency = transparency
    return stroke
end

local function ensureGradient(target, name, colorA, colorB, rotation)
    local gradient = ensureInstance(target, "UIGradient", name)
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, colorA),
        ColorSequenceKeypoint.new(1, colorB),
    })
    gradient.Rotation = rotation or 90
    return gradient
end

local function ensurePadding(target, name, left, right, top, bottom)
    local padding = ensureInstance(target, "UIPadding", name)
    padding.PaddingLeft = UDim.new(0, left)
    padding.PaddingRight = UDim.new(0, right)
    padding.PaddingTop = UDim.new(0, top)
    padding.PaddingBottom = UDim.new(0, bottom)
    return padding
end

function cloneColorTable(source)
    local copy = {}
    for key, value in pairs(source or {}) do
        copy[key] = value
    end
    return copy
end

function serializeColorTable(source)
    local data = {}
    for key, value in pairs(source or {}) do
        if typeof(value) == "Color3" then
            data[key] = {R = value.R, G = value.G, B = value.B}
        end
    end
    return data
end

function deserializeColorTable(source)
    local data = {}
    for key, value in pairs(source or {}) do
        if type(value) == "table" and value.R and value.G and value.B then
            data[key] = Color3.new(value.R, value.G, value.B)
        end
    end
    return data
end

function captureCurrentTheme()
    local palette = {}
    for _, def in ipairs(themeColorDefs) do
        palette[def.key] = colors[def.key]
    end
    return palette
end

function applyColorTable(source)
    for key, value in pairs(source or {}) do
        if typeof(value) == "Color3" then
            colors[key] = value
        end
    end
    if particlesEnabled and #particles > 0 then
        updateParticleColor()
    end
    updateOverlayWidgets()
end

function makeOverlayDraggable(frame, xKey, yKey)
    if not frame or frame:GetAttribute("Nez0xDragReady") then
        return
    end

    frame.Active = true
    frame:SetAttribute("Nez0xDragReady", true)

    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if xKey then
                        uiSettings[xKey] = frame.Position.X.Scale
                    end
                    if yKey then
                        uiSettings[yKey] = frame.Position.Y.Scale
                    end
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input == dragInput and dragStart and startPos then
            local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
            local delta = input.Position - dragStart
            local nextX = startPos.X.Scale + (delta.X / math.max(viewport.X, 1))
            local nextY = startPos.Y.Scale + (delta.Y / math.max(viewport.Y, 1))
            frame.Position = UDim2.new(math.clamp(nextX, 0, 0.82), 0, math.clamp(nextY, 0, 0.88), 0)
        end
    end)
end

function getPlayerEquippedSummary(plr)
    if not plr or not plr.Character then
        return "No Tool"
    end

    local toolNames = {}
    for _, child in ipairs(plr.Character:GetChildren()) do
        if child:IsA("Tool") then
            table.insert(toolNames, child.Name)
        end
    end

    if #toolNames == 0 then
        return "Hands"
    end

    return table.concat(toolNames, ", ")
end

function getPlayerHudRows(limit)
    local rows = {}
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local root = plr.Character.HumanoidRootPart
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local distance = myRoot and (myRoot.Position - root.Position).Magnitude or 0

            table.insert(rows, {
                player = plr,
                distance = distance,
                health = hum and hum.Health or 0,
                maxHealth = hum and hum.MaxHealth or 100,
                toolText = getPlayerEquippedSummary(plr),
            })
        end
    end

    table.sort(rows, function(a, b)
        return a.distance < b.distance
    end)

    while #rows > (limit or 6) do
        table.remove(rows)
    end

    return rows
end

function getPreferredTargetPlayer()
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        return nil
    end

    local bestPlayer = nil
    local bestScore = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if not friends[plr.UserId] then
                local root = plr.Character.HumanoidRootPart
                local distance = (myRoot.Position - root.Position).Magnitude
                if distance < bestScore then
                    bestScore = distance
                    bestPlayer = plr
                end
            end
        end
    end

    return bestPlayer
end

