function loadConfig()
    configFileName = getNormalizedConfigFileName(configFileName)

    local success, content = pcall(function()
        return readfile(configFileName)
    end)
    
    if success and content and content ~= "" then
        local decoded = HttpService:JSONDecode(content)
        if decoded then
            friends = decoded.friends or {}
            teleportPoints = decoded.teleportPoints or {}
            guiSize = decoded.guiSize or 1.0
            mainTransparency = decoded.mainTransparency or 0.45
            panelTransparency = decoded.panelTransparency or 0.18
            buttonTransparency = decoded.buttonTransparency or 0.22
            espMode = decoded.espMode or "Все"
            binds = decoded.binds or {}
            uiSettings.savedThemes = {}

            if decoded.particleSettings then
                for k, v in pairs(decoded.particleSettings) do
                    particleSettings[k] = v
                end
            end

            if decoded.colors then
                local savedAccent = decoded.colors.accent
                local savedPanel = decoded.colors.panel
                local legacyDefaultTheme = savedAccent and savedPanel
                    and math.abs(savedAccent.R - (70 / 255)) < 0.01
                    and math.abs(savedAccent.G - (80 / 255)) < 0.01
                    and math.abs(savedAccent.B - (140 / 255)) < 0.01
                    and math.abs(savedPanel.R - (18 / 255)) < 0.01
                    and math.abs(savedPanel.G - (18 / 255)) < 0.01
                    and math.abs(savedPanel.B - (22 / 255)) < 0.01

                if not legacyDefaultTheme then
                    for k, v in pairs(deserializeColorTable(decoded.colors)) do
                        colors[k] = v
                    end
                end
            end

            if decoded.savedThemes then
                for themeName, palette in pairs(decoded.savedThemes) do
