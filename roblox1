local particles = {}
local angles = {}
local particlesTarget = false
local particleTime = 0

local function getClosestPlayer()
    local closest
    local dist = math.huge
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - root.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = plr
                end
            end
        end
    end
    return closest
end

local function clearParticles()
    for _, p in ipairs(particles) do
        if p then p:Destroy() end
    end
    particles = {}
    angles = {}
end

local function updateParticleColor()
    for _, p in ipairs(particles) do
        if p and p:IsA("Part") then
            p.Color = colors.accentLight
            for _, descendant in ipairs(p:GetDescendants()) do
                if descendant:IsA("Trail") then
                    descendant.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, colors.accentLight),
                        ColorSequenceKeypoint.new(1, colors.accent),
                    })
                elseif descendant:IsA("PointLight") then
                    descendant.Color = colors.accentLight
                end
            end
        end
    end
end

local function getParticleAnchorRoot()
    local targetChar = nil

    if particlesTarget then
        local plr = getClosestPlayer()
        if plr then
            targetChar = plr.Character
        end
    else
        targetChar = player.Character
    end

    if targetChar then
        return targetChar:FindFirstChild("HumanoidRootPart")
    end
end

local function getParticleCenter()
    local root = getParticleAnchorRoot()
    if root then
        return root.Position, root
    end

    local camera = Workspace.CurrentCamera
    if camera then
        return camera.CFrame.Position + camera.CFrame.LookVector * 18, nil
    end

    return Vector3.new(), nil
end

local function resetWorldParticle(p, state, center)
    local spread = math.max(12, particleSettings.spread or 50)
    local lift = math.max(5, (particleSettings.height or 2.6) * 6)
    local offset = Vector3.new(
        (math.random() * 2 - 1) * spread,
        1.5 + math.random() * lift,
        (math.random() * 2 - 1) * spread
    )

    local direction = Vector3.new(
        math.random() * 2 - 1,
        math.random() * 0.85 + 0.15,
        math.random() * 2 - 1
    )

    if direction.Magnitude < 0.05 then
        direction = Vector3.new(0.2, 0.85, 0.15)
    end

    state.worldOrigin = center + offset
    state.worldVelocity = direction.Unit * (math.max(0.6, particleSettings.speed) * (1.7 + math.random() * 1.9))
    state.life = 0
    state.duration = math.max(1.5, (particleSettings.lifetime or 5) * (0.7 + math.random() * 0.9))
    state.phase = math.random() * math.pi * 2
    state.lift = math.random() * math.pi * 2

    p.Position = state.worldOrigin
end

local function createParticles()
    clearParticles()
    local center = getParticleCenter()
    
    for i = 1, particleSettings.count do
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball
        p.Size = Vector3.new(particleSettings.size, particleSettings.size, particleSettings.size)
        p.Material = Enum.Material.Neon
        p.Color = colors.accentLight
        p.Anchored = true
        p.CanCollide = false
        p.CastShadow = false
        p.Transparency = particleSettings.opacity
        p.Parent = Workspace

        local topAttachment = Instance.new("Attachment")
        topAttachment.Position = Vector3.new(0, particleSettings.size * 0.4, 0)
        topAttachment.Parent = p

        local bottomAttachment = Instance.new("Attachment")
        bottomAttachment.Position = Vector3.new(0, -(particleSettings.size * 0.4), 0)
        bottomAttachment.Parent = p

        local trail = Instance.new("Trail")
        trail.Attachment0 = topAttachment
        trail.Attachment1 = bottomAttachment
        trail.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, colors.accentLight),
            ColorSequenceKeypoint.new(1, colors.accent),
        })
        trail.LightEmission = 1
        trail.Lifetime = 0.16
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(1, 1),
        })
        trail.Parent = p

        local light = Instance.new("PointLight")
        light.Color = colors.accentLight
        light.Brightness = 0.65
        light.Range = math.max(4, particleSettings.radius * 0.7)
        light.Parent = p
        
        table.insert(particles, p)

        if utilitySettings.useLegacyParticles then
            p.Position = center
            table.insert(angles, math.random() * math.pi * 2)
        else
            local state = {
                angle = math.random() * math.pi * 2,
                lift = math.random() * math.pi * 2,
                orbitScale = 0.65 + math.random() * 0.9,
                pulse = math.random() * math.pi * 2,
                phase = math.random() * math.pi * 2,
                life = 0,
                duration = particleSettings.lifetime or 5,
            }

            table.insert(angles, state)

            if particleSettings.worldMode then
                resetWorldParticle(p, state, center)
            else
                p.Position = center
            end
        end
    end
    
    particleTime = 0
end

RunService.RenderStepped:Connect(function(dt)
    if not particlesEnabled or utilitySettings.useLegacyParticles == false then return end
    
    local targetChar
    if particlesTarget then
        local plr = getClosestPlayer()
        if plr then targetChar = plr.Character end
    else
        targetChar = player.Character
    end
    
    if not targetChar then return end
    
    local root = targetChar:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    particleTime = particleTime + dt
    
    for i, p in ipairs(particles) do
        angles[i] = angles[i] + dt * 2
        
        if particleSettings.mode == "Круговой" then
            local x = math.cos(angles[i]) * 8
            local z = math.sin(angles[i]) * 8
            local target = root.Position + Vector3.new(x, 1, z)
            p.Position = p.Position:Lerp(target, 0.06)
            
        elseif particleSettings.mode == "Вертикальный" then
            local x = math.cos(angles[i]) * 8
            local z = math.sin(angles[i]) * 8
            local yOffset = math.sin(particleTime * 2 + i) * 3
            local target = root.Position + Vector3.new(x, 1 + yOffset, z)
            p.Position = p.Position:Lerp(target, 0.06)
            
        elseif particleSettings.mode == "Крест" then
            local angle = angles[i]
            local radius = 8
            
            if i % 2 == 0 then
                local x = math.cos(angle) * radius
                local z = math.sin(angle) * radius
                local target = root.Position + Vector3.new(x, 1, z)
                p.Position = p.Position:Lerp(target, 0.06)
            else
                local x = math.cos(angle + math.pi/4) * radius
                local z = math.sin(angle + math.pi/4) * radius
                local target = root.Position + Vector3.new(x, 1, z)
                p.Position = p.Position:Lerp(target, 0.06)
            end
            
        elseif particleSettings.mode == "Вихрь" then
            local radius = 5 + math.sin(particleTime * 3 + i) * 3
            local height = math.sin(particleTime * 2 + i) * 4
            local x = math.cos(angles[i] + particleTime) * radius
            local z = math.sin(angles[i] + particleTime) * radius
            local target = root.Position + Vector3.new(x, 2 + height, z)
            p.Position = p.Position:Lerp(target, 0.06)
            
        elseif particleSettings.mode == "Сфера" then
            local theta = angles[i] + particleTime
            local phi = angles[i] * 2
            local radius = 6
            local x = math.sin(theta) * math.cos(phi) * radius
            local y = math.sin(theta) * math.sin(phi) * radius
            local z = math.cos(theta) * radius
            local target = root.Position + Vector3.new(x, y + 2, z)
            p.Position = p.Position:Lerp(target, 0.06)
        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not particlesEnabled or utilitySettings.useLegacyParticles then
        return
    end

    local center, root = getParticleCenter()
    if not particleSettings.worldMode and not root then
        return
    end

    particleTime = particleTime + dt

    for i, p in ipairs(particles) do
        local state = angles[i]
        if p and state then
            if particleSettings.worldMode then
                state.life = (state.life or 0) + dt
                if state.life >= (state.duration or particleSettings.lifetime or 5) then
                    resetWorldParticle(p, state, center)
                else
                    local driftX = math.cos(state.phase + state.life * 1.4) * math.max(0.25, particleSettings.drift) * 2.1
                    local driftY = math.sin(state.lift + state.life * 1.8) * math.max(0.2, particleSettings.height) * 0.45
                    local driftZ = math.sin(state.phase + state.life * 1.2) * math.max(0.25, particleSettings.drift) * 2.1
                    local target = state.worldOrigin
                        + state.worldVelocity * state.life
                        + Vector3.new(driftX, driftY, driftZ)

                    local lerpAlpha = math.clamp(dt * (5.2 + particleSettings.speed * 1.4), 0, 1)
                    local lifeAlpha = math.clamp(state.life / math.max(state.duration or 1, 0.001), 0, 1)
                    local pulseScale = 1 + math.sin(state.phase + state.life * 3.2) * (particleSettings.pulse * 0.16)
                    local partSize = math.max(0.12, particleSettings.size * pulseScale * (1 - lifeAlpha * 0.22))

                    p.Position = p.Position:Lerp(target, lerpAlpha)
                    p.Size = Vector3.new(partSize, partSize, partSize)
                    p.Transparency = math.clamp(particleSettings.opacity + lifeAlpha * 0.42, 0.04, 0.9)
                end

                continue
            end

            state.angle = state.angle + dt * particleSettings.speed * state.orbitScale

            local radius = math.max(1.5, particleSettings.radius + math.sin(particleTime * 1.8 + state.pulse) * particleSettings.drift)
            local height = math.sin(particleTime * (particleSettings.speed * 0.8) + state.lift) * particleSettings.height
            local x, y, z = 0, 0, 0

            if particleSettings.mode == "Круговой" then
                x = math.cos(state.angle) * radius
                z = math.sin(state.angle) * radius
                y = 1.6 + height * 0.3

            elseif particleSettings.mode == "Вертикальный" then
                x = math.cos(state.angle) * radius * 0.42
                z = math.sin(state.angle) * radius * 0.42
                y = 1.3 + height

            elseif particleSettings.mode == "Крест" then
                if i % 2 == 0 then
                    x = math.cos(state.angle) * radius
                    z = 0
                else
                    x = 0
                    z = math.sin(state.angle) * radius
                end
                y = 1.5 + height * 0.16

            elseif particleSettings.mode == "Вихрь" then
                local swirlRadius = radius * (0.72 + math.sin(particleTime + state.phase) * 0.18)
                x = math.cos(state.angle + particleTime * 0.8) * swirlRadius
                z = math.sin(state.angle + particleTime * 0.8) * swirlRadius
                y = 1.8 + height + math.sin(state.angle * 2) * 1.2

            elseif particleSettings.mode == "Сфера" then
                local theta = state.angle + particleTime * 0.25
                local phi = state.lift + particleTime * 0.35
                local sphereRadius = radius * 0.88
                x = math.cos(theta) * math.sin(phi) * sphereRadius
                y = math.cos(phi) * sphereRadius + 2
                z = math.sin(theta) * math.sin(phi) * sphereRadius
            end

            local target = root.Position + Vector3.new(x, y, z)
            local lerpAlpha = math.clamp(dt * (6 + particleSettings.speed * 1.6), 0, 1)
            p.Position = p.Position:Lerp(target, lerpAlpha)

            local pulseScale = 1 + math.sin(particleTime * 3 + state.pulse) * (particleSettings.pulse * 0.18)
            local partSize = math.max(0.15, particleSettings.size * pulseScale)
            p.Size = Vector3.new(partSize, partSize, partSize)
            p.Transparency = math.clamp(particleSettings.opacity + math.sin(particleTime * 2.7 + state.pulse) * 0.06, 0.04, 0.75)
        end
    end
end)

