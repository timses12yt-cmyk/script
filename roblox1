    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 1, 0)
    card.BorderSizePixel = 0
    card.BackgroundTransparency = 0.08
    card.Parent = bill
    ensureCorner(card, 12)
    ensureStroke(card, "EspStroke", accentOutline, 1, 0.12)
    ensureGradient(card, "EspGradient", colors.panel, colors.background, 90)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, -12, 0, 18)
    nameLabel.Position = UDim2.new(0, 6, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.TextSize = 12
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = card

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Name = "InfoLabel"
    infoLabel.Size = UDim2.new(1, -12, 0, 26)
    infoLabel.Position = UDim2.new(0, 6, 0, 24)
    infoLabel.BackgroundTransparency = 1
    infoLabel.Font = Enum.Font.Gotham
    infoLabel.TextSize = 10
    infoLabel.TextWrapped = true
    infoLabel.TextXAlignment = Enum.TextXAlignment.Left
    infoLabel.TextYAlignment = Enum.TextYAlignment.Top
    infoLabel.Parent = card

    local hitboxBox = Instance.new("BoxHandleAdornment")
    hitboxBox.Name = "Nez0xEspHitbox"
    hitboxBox.AlwaysOnTop = true
    hitboxBox.Transparency = 0.78
    hitboxBox.Size = head.Size + Vector3.new(0.04, 0.04, 0.04)
    hitboxBox.Color3 = accentOutline
    hitboxBox.Adornee = head
    hitboxBox.Parent = head
    table.insert(entry.visuals, hitboxBox)

    entry.renderConnection = RunService.RenderStepped:Connect(function()
        if not shouldTrackPlayerEsp(plr) or not plr.Parent or not char.Parent or not root.Parent then
            highlight.Enabled = false
            bill.Enabled = false
            hitboxBox.Visible = false
            return
        end

        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            highlight.Enabled = false
            bill.Enabled = false
            hitboxBox.Visible = false
            return
        end

        local dist = (myRoot.Position - root.Position).Magnitude
        local visible = dist <= utilitySettings.espDistance
        local outlineColor, fillColor = getPlayerEspAccent(plr)
        local currentHum = hum
        if not currentHum or not currentHum.Parent then
            currentHum = char:FindFirstChildOfClass("Humanoid")
            hum = currentHum
        end

        card.BackgroundColor3 = colors.panel
        bill.Size = UDim2.new(0, math.floor(utilitySettings.espTagWidth or 176), 0, math.floor(utilitySettings.espTagHeight or 54))
        ensureStroke(card, "EspStroke", outlineColor, 1, 0.12)
        highlight.FillColor = fillColor
        highlight.OutlineColor = outlineColor
        nameLabel.TextColor3 = colors.text
        infoLabel.TextColor3 = colors.textDim

        local displayName = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
        local hp = currentHum and currentHum.Health or 0
        local maxHp = currentHum and currentHum.MaxHealth or 100
        local toolText = getPlayerEquippedSummary(plr)

        nameLabel.Text = string.format("%s  [%dm]", displayName, math.floor(dist + 0.5))
        infoLabel.Text = string.format("HP %.0f/%.0f   %s", hp, maxHp, toolText)

        highlight.Enabled = visible
        bill.Enabled = visible
        hitboxBox.Visible = visible and utilitySettings.hitboxEnabled
        hitboxBox.Color3 = outlineColor
        hitboxBox.Size = head.Size + Vector3.new(0.04, 0.04, 0.04)
    end)
end

function createESPPlayer(plr)
    if not plr or plr == player or espObjects[plr] then
        return
    end

    espObjects[plr] = {
        visuals = {},
        renderConnection = nil,
    }

    espObjects[plr].charAddedConnection = plr.CharacterAdded:Connect(function(char)
        if shouldTrackPlayerEsp(plr) then
            bindESPCharacter(plr, char)
        end
    end)

    espObjects[plr].charRemovingConnection = plr.CharacterRemoving:Connect(function()
        local entry = espObjects[plr]
        if entry then
            clearESPVisuals(entry)
        end
    end)

    if plr.Character and shouldTrackPlayerEsp(plr) then
        bindESPCharacter(plr, plr.Character)
    end
end

function updateESPPlayers()
    for trackedPlayer, _ in pairs(espObjects) do
        if not trackedPlayer or not trackedPlayer.Parent or not shouldTrackPlayerEsp(trackedPlayer) then
            clearESPPlayer(trackedPlayer)
        end
    end
    
    if not espEnabled then
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if shouldTrackPlayerEsp(p) then
            createESPPlayer(p)
        end
    end
--[[

    if espMode == "Все" or espMode == "Игроки" or espMode == "Друзья" then
        for _, p in ipairs(Players:GetPlayers()) do
            if espMode == "Друзья" and not friends[p.UserId] then continue end
