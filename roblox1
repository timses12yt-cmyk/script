    local dragging = false

    local function updateThumb(relative)
        relative = relative or math.clamp(slider.Size.X.Scale, 0, 1)
        sliderThumb.Position = UDim2.new(relative, 0, 0.5, 0)
    end

    dragButton.MouseButton1Down:Connect(function() dragging = true end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = UIS:GetMouseLocation()
            local absPos = sliderBg.AbsolutePosition
            local size = sliderBg.AbsoluteSize.X
            local relative = math.clamp((mousePos.X - absPos.X) / size, 0, 1)
            slider:TweenSize(UDim2.new(relative, 0, 1, 0), "Out", "Quad", 0.1, true)
            local value = min + (max - min) * relative
            value = math.floor(value * 100) / 100
            valueLabel.Text = tostring(value) .. suffix
            setVar(value)
            updateThumb(relative)
            styleSliderContainer(container)
            if currentModule == "THEME" then
                applyNursultanChrome()
                if themeEditorSync then
                    themeEditorSync()
                end
            end
            saveConfig()
        end
    end)

    slider:GetPropertyChangedSignal("Size"):Connect(function()
        updateThumb()
    end)

    updateThumb()
    styleSliderContainer(container)

    return container
end

