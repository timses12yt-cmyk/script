-- 1. Instant Heal - мгновенное восстановление при получении урона
local instantHealConnection = nil
local function setupInstantHeal(character)
    if instantHealConnection then instantHealConnection:Disconnect() end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and instantHealEnabled then
        instantHealConnection = hum.HealthChanged:Connect(function(health)
            if health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end)
    end
end

-- 2. No Damage - делает игрока неуязвимым
local function updateNoDamage()
    if noDamageEnabled and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.MaxHealth = 9e9
            hum.Health = 9e9
            hum.BreakJointsOnDeath = false
        end
    elseif player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.MaxHealth ~= 100 then
            hum.MaxHealth = 100
            hum.BreakJointsOnDeath = true
        end
    end
end

-- 3. Force Field - создает защитное поле
local forceField = nil
local function updateForceField()
    if forceField then forceField:Destroy() end
    if not forceFieldEnabled then return end
    if not player.Character then return end
    
    forceField = Instance.new("ForceField")
    forceField.Name = "GodShield"
    forceField.Visible = false
    forceField.Parent = player.Character
end

-- 4. Infinite Health - огромное здоровье
local function updateInfiniteHealth()
    if infiniteHealthEnabled and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.MaxHealth = 999999
            if hum.Health < 999999 then
                hum.Health = 999999
            end
        end
    elseif player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.MaxHealth ~= 100 then
            hum.MaxHealth = 100
        end
    end
end

-- 5. Anti-Death - не дает умереть
local function updateAntiDeath()
    if antiDeathEnabled and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then
            hum.Health = hum.MaxHealth
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Position = hrp.Position + Vector3.new(0, 5, 0)
            end
        end
    end
end

-- Обновление всех способов бессмертия
local function updateAllGodModes()
    updateNoDamage()
    updateForceField()
    updateInfiniteHealth()
    updateAntiDeath()
    
    if player.Character and instantHealEnabled then
        setupInstantHeal(player.Character)
    end
end

