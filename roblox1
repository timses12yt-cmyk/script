local function styleActionButton(button)
    local parentName = button.Parent and button.Parent.Name or ""
    if parentName:find("Container") or parentName:find("Slider") then
        return
    end

    local lowerName = string.lower(button.Name or "")
    local lowerText = string.lower(button.Text or "")
    local themeElement = button:GetAttribute("ThemeElement")
    local themeSelected = themeElement and uiSettings.selectedThemeElement == themeElement
    local isDanger = button.BackgroundColor3 == colors.danger or lowerName:find("kill") or lowerName:find("unhook") or lowerText:find("kill") or lowerText:find("unhook")
    local isSave = lowerName:find("save") or lowerText:find("save")
    local isAdminStyle = button.BackgroundColor3 == colors.admin or lowerName:find("admin")
    local isAccent = button.BackgroundColor3 == colors.accent or lowerName:find("teleport") or lowerName:find("follow") or lowerName:find("theme") or lowerText:find("theme")
    local isGreen = button.BackgroundColor3.G > (button.BackgroundColor3.R + 0.08) and button.BackgroundColor3.G > (button.BackgroundColor3.B + 0.08)
    local preserveThemePreview = button.Parent == themeEditorScroll and not isDanger and not isSave and not lowerText:find("reset")

    local fill = colors.panel
    local strokeColor = colors.panelLight

    if preserveThemePreview then
        fill = button.BackgroundColor3
        strokeColor = isBrightColor(fill) and colors.panel or colors.accentLight
    elseif isDanger then
        fill = colors.danger
        strokeColor = colors.danger
    elseif isAdminStyle then
        fill = colors.admin
        strokeColor = colors.accentLight
    elseif isSave or isGreen then
        fill = colors.friend
        strokeColor = colors.accentLight
    elseif isAccent then
        fill = colors.accent
        strokeColor = colors.accentLight
    end

    button.BorderSizePixel = 0
    if button.Parent and button.Parent:IsA("ScrollingFrame") then
        button.Size = UDim2.new(1, -8, 0, math.max(button.Size.Y.Offset, 30))
    end
    if button.BackgroundTransparency < 1 then
        button.BackgroundTransparency = math.min(buttonTransparency, 0.18)
    end
    button.BackgroundColor3 = fill
    ensureCorner(button, 9)
    ensureStroke(button, "NursultanStroke", themeSelected and colors.accentLight or strokeColor, 1, themeSelected and 0.02 or ((isDanger or isAccent or isAdminStyle or isSave or isGreen or preserveThemePreview) and 0.2 or 0.55))

    if button.Text ~= "" then
        button.TextColor3 = (isDanger or isAccent or isAdminStyle or isSave or isGreen or preserveThemePreview) and readableTextColor(fill) or colors.text
        if button.TextSize < 13 then
            button.TextSize = 13
        end
        button.Font = Enum.Font.Gotham
    end
end

