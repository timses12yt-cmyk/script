function updateFunctions()
    local columnOrder = {"COMBAT", "MOVEMENT", "VISUALS", "PLAYER", "MISC"}

    if type(enforcePremiumAccess) == "function" then
        enforcePremiumAccess()
    end

    local okLayout, errLayout = pcall(function()
        resizeReferenceLayout(guiSize)
        populateThemeEditor()
    end)
    if not okLayout then
        warn("updateFunctions layout error: " .. tostring(errLayout))
    end

    for _, columnId in ipairs(columnOrder) do
        local moduleList = columnSections[columnId]
        local target = centerColumnTargets[columnId]

        if moduleList and target then
            clearRenderContainer(target)

            for index, moduleName in ipairs(moduleList) do
                local okModule, errModule = pcall(function()
                    if index > 1 then
                        createSectionHeader(target, moduleDisplayNames[moduleName] or moduleName)
                    end
                    populateModuleContents(moduleName, target, index > 1)
                end)

                if not okModule then
                    warn("updateFunctions module error [" .. moduleName .. "]: " .. tostring(errModule))

                    local errorLabel = Instance.new("TextLabel")
                    errorLabel.Size = UDim2.new(1, -8, 0, 24)
                    errorLabel.BackgroundTransparency = 1
                    errorLabel.Text = moduleName .. " load error"
                    errorLabel.TextColor3 = colors.danger
                    errorLabel.TextSize = 12
                    errorLabel.Font = Enum.Font.GothamSemibold
                    errorLabel.TextXAlignment = Enum.TextXAlignment.Left
                    errorLabel.ZIndex = 1204
                    errorLabel.Parent = target
                end
            end
        end
    end

    local okFinal, errFinal = pcall(function()
        indexSearchableRoots()
        applyNursultanChrome()
        applySearchFilter()
        updateConfigMeta()
        refreshConfigList()
    end)
    if not okFinal then
        warn("updateFunctions finalization error: " .. tostring(errFinal))
    end
end

