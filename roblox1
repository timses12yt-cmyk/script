    if utilitySettings.lowGraphicsEnabled then
        if not utilitySettings.graphicsCache then
            utilitySettings.graphicsCache = {
                effects = {},
                terrain = terrain and {
                    WaterWaveSize = terrain.WaterWaveSize,
                    WaterWaveSpeed = terrain.WaterWaveSpeed,
                    WaterReflectance = terrain.WaterReflectance,
                    WaterTransparency = terrain.WaterTransparency,
                } or nil
            }

            for _, effect in ipairs(Lighting:GetChildren()) do
                if effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") or effect:IsA("BloomEffect") or effect:IsA("ColorCorrectionEffect") then
                    utilitySettings.graphicsCache.effects[effect] = effect.Enabled
                end
            end
        end

        for effect, _ in pairs(utilitySettings.graphicsCache.effects or {}) do
            if effect and effect.Parent then
                pcall(function()
                    effect.Enabled = false
                end)
            end
        end

        if terrain then
            pcall(function()
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 1
            end)
        end
    elseif utilitySettings.graphicsCache then
        for effect, enabled in pairs(utilitySettings.graphicsCache.effects or {}) do
            if effect and effect.Parent then
                pcall(function()
                    effect.Enabled = enabled
                end)
            end
        end

        if terrain and utilitySettings.graphicsCache.terrain then
            pcall(function()
                terrain.WaterWaveSize = utilitySettings.graphicsCache.terrain.WaterWaveSize
                terrain.WaterWaveSpeed = utilitySettings.graphicsCache.terrain.WaterWaveSpeed
                terrain.WaterReflectance = utilitySettings.graphicsCache.terrain.WaterReflectance
                terrain.WaterTransparency = utilitySettings.graphicsCache.terrain.WaterTransparency
            end)
        end
    end
end

