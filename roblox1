function collectSearchText(root)
    local chunks = {}

    local function push(text)
        if text and text ~= "" then
            table.insert(chunks, string.lower(text))
        end
    end

    if root:IsA("TextButton") or root:IsA("TextLabel") or root:IsA("TextBox") then
        push(root.Text)
        if root:IsA("TextBox") then
            push(root.PlaceholderText)
        end
    end

    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("TextButton") or descendant:IsA("TextLabel") or descendant:IsA("TextBox") then
            push(descendant.Text)
            if descendant:IsA("TextBox") then
                push(descendant.PlaceholderText)
            end
        end
    end

    return table.concat(chunks, " ")
end

function applySearchFilter()
    local query = string.lower(searchBox.Text or "")
    for _, entry in ipairs(searchableRoots) do
        if query == "" then
            entry.root.Visible = true
        else
            entry.root.Visible = entry.text:find(query, 1, true) ~= nil
        end
    end

    if query == "" then
        topHintLabel.Text = defaultHintText
    else
        topHintLabel.Text = "Results for: " .. query
    end
end

function indexSearchableRoots()
    searchableRoots = {}
    local targets = {themeEditorScroll}
    for _, target in pairs(centerColumnTargets) do
        table.insert(targets, target)
    end

    for _, target in ipairs(targets) do
        for _, child in ipairs(target:GetChildren()) do
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                local hoverTarget = nil
                if child:IsA("TextButton") then
                    hoverTarget = child
                else
                    hoverTarget = child:FindFirstChildWhichIsA("TextButton", true)
                end

                if hoverTarget then
                    local hoverText = collectSearchText(child)
                    if #hoverText > 88 then
                        hoverText = string.sub(hoverText, 1, 88) .. "..."
                    end
                    hoverTarget.MouseEnter:Connect(function()
                        if searchBox.Text == "" and hoverText ~= "" then
                            topHintLabel.Text = hoverText
                        end
                    end)
                    hoverTarget.MouseLeave:Connect(function()
                        applySearchFilter()
                    end)
                end

                table.insert(searchableRoots, {
                    root = child,
                    text = collectSearchText(child),
                })
            end
        end
    end
end

function resizeReferenceLayout(scale)
    local viewport = referenceRoot.AbsoluteSize
    if viewport.X <= 0 or viewport.Y <= 0 then
        local camera = Workspace.CurrentCamera
        if camera then
            viewport = camera.ViewportSize
        else
            viewport = Vector2.new(1920, 1080)
        end
    end

    local baseGap = 14
    local baseThemeWidth = 160
    local baseThemeHeight = 392
    local baseColumnsWidth = 840
    local baseColumnsHeight = 396
    local baseRightWidth = 160
    local baseRightHeight = 290
    local baseSearchWidth = 220
    local baseSearchHeight = 54

    local widthFit = (viewport.X - 56) / (baseThemeWidth + baseColumnsWidth + baseRightWidth + baseGap * 2)
    local heightFit = (viewport.Y - 220) / (baseColumnsHeight + baseSearchHeight + 20)
    local resolvedScale = math.max(minSize, math.min(scale, maxSize, widthFit, heightFit))

    local gap = math.floor(baseGap * resolvedScale)
    local themeWidth = math.floor(baseThemeWidth * resolvedScale)
    local themeHeight = math.floor(baseThemeHeight * resolvedScale)
    local columnsWidth = math.floor(baseColumnsWidth * resolvedScale)
    local columnsHeight = math.floor(baseColumnsHeight * resolvedScale)
    local rightWidth = math.floor(baseRightWidth * resolvedScale)
    local rightHeight = math.floor(baseRightHeight * resolvedScale)
    local searchWidth = math.floor(baseSearchWidth * resolvedScale)
    local searchHeight = math.floor(baseSearchHeight * resolvedScale)

    local groupWidth = themeWidth + gap + columnsWidth + gap + rightWidth
    local groupLeft = math.floor((viewport.X - groupWidth) / 2)
    local columnsTop = math.max(118, math.floor((viewport.Y - (columnsHeight + searchHeight + 20)) / 2))

    leftThemePanel.Size = UDim2.new(0, themeWidth, 0, themeHeight)
    leftThemePanel.Position = UDim2.new(0, groupLeft, 0, columnsTop + math.floor((columnsHeight - themeHeight) / 2))
    columnsFrame.Size = UDim2.new(0, columnsWidth, 0, columnsHeight)
    columnsFrame.Position = UDim2.new(0, groupLeft + themeWidth + gap, 0, columnsTop)
    for _, panel in pairs(centerColumns) do
        panel.Size = UDim2.new(0, themeWidth, 0, columnsHeight)
    end
    rightConfigPanel.Size = UDim2.new(0, rightWidth, 0, rightHeight)
    rightConfigPanel.Position = UDim2.new(0, groupLeft + themeWidth + gap + columnsWidth + gap, 0, columnsTop + columnsHeight - rightHeight)
    searchPanel.Size = UDim2.new(0, searchWidth, 0, searchHeight)
    searchPanel.Position = UDim2.new(0, math.floor(viewport.X / 2 - searchWidth / 2), 0, columnsTop + columnsHeight + 18)
end

