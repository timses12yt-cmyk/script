configRegistryFileName = "Nez0xConfigIndex.json"

function getNormalizedConfigFileName(rawName)
    local clean = tostring(rawName or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" then
        clean = "runtime"
    end
    if not clean:lower():find("%.json$") then
        clean = clean .. ".json"
    end
    return clean
end

function readConfigRegistry()
    local names = {}
    local seen = {}

    local function push(name)
        local normalized = getNormalizedConfigFileName(name)
        if normalized ~= configRegistryFileName and not seen[normalized] then
            seen[normalized] = true
            table.insert(names, normalized)
        end
    end

    local activeName = getNormalizedConfigFileName(configFileName or "runtime")
    local hasActiveConfig = false

    if type(isfile) == "function" then
        local okExists, exists = pcall(function()
            return isfile(activeName)
        end)
        hasActiveConfig = okExists and exists
    else
        hasActiveConfig = pcall(function()
            return readfile(activeName)
        end)
    end

    if hasActiveConfig then
        push(activeName)
    end

    local okRegistry, content = pcall(function()
        return readfile(configRegistryFileName)
    end)

    if okRegistry and content and content ~= "" then
        local okDecoded, decoded = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if okDecoded and type(decoded) == "table" then
            for _, fileName in ipairs(decoded) do
                push(fileName)
            end
        end
    end

    if type(listfiles) == "function" then
        local okFiles, fileCandidates = pcall(function()
            return listfiles("")
        end)

        if (not okFiles or type(fileCandidates) ~= "table") then
            okFiles, fileCandidates = pcall(function()
                return listfiles(".")
            end)
        end

        if okFiles and type(fileCandidates) == "table" then
            for _, path in ipairs(fileCandidates) do
                local fileName = tostring(path):match("[^/\\\\]+%.json$")
                if fileName and fileName ~= configRegistryFileName then
                    local okJson, decoded = pcall(function()
                        local raw = readfile(fileName)
                        return HttpService:JSONDecode(raw)
                    end)

                    if okJson and type(decoded) == "table" and (decoded.settings or decoded.uiSettings or decoded.colors or decoded.particleSettings) then
                        push(fileName)
                    end
                end
            end
        end
    end

    table.sort(names, function(a, b)
        return string.lower(a) < string.lower(b)
    end)

    return names
end

function writeConfigRegistry(names)
    pcall(function()
        writefile(configRegistryFileName, HttpService:JSONEncode(names))
    end)
end

function registerConfigName(name)
    local names = readConfigRegistry()
    local normalized = getNormalizedConfigFileName(name)
    local exists = false

    for _, fileName in ipairs(names) do
        if fileName == normalized then
            exists = true
            break
        end
    end

    if not exists then
        table.insert(names, normalized)
        table.sort(names, function(a, b)
            return string.lower(a) < string.lower(b)
        end)
    end

    writeConfigRegistry(names)
    return names
end

function refreshConfigList()
    if not configListScroll then
        return
    end

    for _, child in ipairs(configListScroll:GetChildren()) do
        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end

    local names = readConfigRegistry()

    if #names == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Name = "ConfigListEmpty"
        emptyLabel.Size = UDim2.new(1, -2, 0, 24)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Text = "No saved configs"
        emptyLabel.TextColor3 = colors.textDim
        emptyLabel.TextSize = 11
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.TextXAlignment = Enum.TextXAlignment.Left
        emptyLabel.ZIndex = 1204
        emptyLabel.Parent = configListScroll
        return
    end

    for _, fileName in ipairs(names) do
        local shortName = fileName:gsub("%.json$", "")
        local button = Instance.new("TextButton")
        button.Name = shortName .. "ConfigButton"
        button.Size = UDim2.new(1, -2, 0, 24)
        button.AutoButtonColor = true
        button.BackgroundColor3 = fileName == configFileName and colors.accent or colors.panelLight
        button.BackgroundTransparency = fileName == configFileName and 0.02 or 0.08
        button.BorderSizePixel = 0
        button.Text = shortName
        button.TextColor3 = fileName == configFileName and readableTextColor(colors.accent) or colors.text
        button.TextSize = 11
        button.Font = Enum.Font.GothamSemibold
        button.ZIndex = 1204
        button.Parent = configListScroll

        local buttonCorner = Instance.new("UICorner")
        buttonCorner.CornerRadius = UDim.new(0, 8)
        buttonCorner.Parent = button

        if type(styleActionButton) == "function" then
            styleActionButton(button)
            button.BackgroundColor3 = fileName == configFileName and colors.accent or colors.panelLight
            button.TextColor3 = fileName == configFileName and readableTextColor(colors.accent) or colors.text
        end

        button.MouseButton1Click:Connect(function()
            configFileName = fileName
            configNameBox.Text = shortName

            local exists = true
            if type(isfile) == "function" then
                local okExists, result = pcall(function()
                    return isfile(fileName)
                end)
                exists = okExists and result
            else
                exists = pcall(function()
                    return readfile(fileName)
                end)
            end

            if exists and type(loadConfig) == "function" then
                loadConfig()
                lastConfigStamp = "loaded " .. os.date("%d.%m.%Y %H:%M")
            end

            updateConfigMeta()
            if type(updateFunctions) == "function" then
                updateFunctions()
            end
        end)
    end
end

