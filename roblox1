function populateModuleContents(moduleName, targetScrolling, appendMode)
    local previousModule = currentModule
    local previousScrolling = functionsScrolling

    currentModule = moduleName
    functionsScrolling = targetScrolling or functionsScrolling

    if not appendMode then
        for _, child in ipairs(functionsScrolling:GetChildren()) do
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end
    end
    
    if currentModule == "COMBAT" then
        createBindButton("Aimbot", function() return aimbotEnabled end, function(v) aimbotEnabled = v end, "Aimbot", function(details)
            createInlineToggle(details, "Aim Through Walls", function() return aimbotThroughWalls end, function(v) aimbotThroughWalls = v end)
            createInlineSlider(details, "Aim Speed", 0.1, 1, function() return aimbotSpeed end, function(v) aimbotSpeed = v end, "")
            createInlineSlider(details, "Randomness", 0, 0.5, function() return aimbotRandom end, function(v) aimbotRandom = v end, "")
            createInlineSlider(details, "Distance", 20, 500, function() return utilitySettings.aimbotDistance end, function(v) utilitySettings.aimbotDistance = math.floor(v) end, "m")
            createInlineChoiceButtons(details, "Aim Part", {"Head", "HumanoidRootPart"}, function() return utilitySettings.aimbotPart end, function(v) utilitySettings.aimbotPart = v end)
        end)
        if adminUnlocked then
            createBindButton("Target Follow", function() return followEnabled end, function(v)
                followEnabled = v
                if followEnabled then
                    local targetName = (followTargetQuery or ""):gsub("^%s+", ""):gsub("%s+$", "")
                    if targetName ~= "" then
                        local found = findPlayerByName(targetName)
                        if found then
                            followTarget = found.Name
                            doFollowLoop()
                        else
                            followEnabled = false
                            followTarget = nil
                            if type(stopFollow) == "function" then
                                stopFollow()
                            end
                            warn("Target Follow: player not found")
                        end
                    else
                        followTarget = nil
                        doFollowLoop()
                    end
                else
                    followTarget = nil
                    if type(stopFollow) == "function" then
                        stopFollow()
                    end
                end
            end, "TargetFollow", function(details)
                createInlineInput(details, "Target", function() return followTargetQuery or "" end, function(v) followTargetQuery = v end, "nick or blank = nearest")
            end, {premium = true})
            createBindButton("Kill All+", function() return killAllEnabled end, function(v)
                killAllEnabled = v
                if killAllEnabled then
                    doKillAllLoop()
                else
                    if killAllConnection then
                        killAllConnection:Disconnect()
                        killAllConnection = nil
                    end
                    killAllTarget = nil
                end
            end, "KillAll", nil, {premium = true})
        end
        
    elseif currentModule == "MOVEMENT" then
        createBindButton("Fly", function() return flyEnabled end, function(v) flyEnabled = v updateFly() end, "Fly", function(details)
            createInlineSlider(details, "Fly Speed", 10, 200, function() return flySpeed end, function(v) flySpeed = v end, "")
        end)
        if adminUnlocked then
            createBindButton("Turbo Fly", function() return turboFlyEnabled end, function(v) turboFlyEnabled = v updateFly() end, "TurboFly", function(details)
                createInlineSlider(details, "Turbo Speed", 100, 500, function() return turboFlySpeed end, function(v) turboFlySpeed = v end, "")
            end, {premium = true})
            createBindButton("Escape Mode", function() return escapeEnabled end, function(v)
                escapeEnabled = v
                if escapeEnabled and testEnabled then
                    doEscapeLoop()
                else
                    if escapeConnection then
                        escapeConnection:Disconnect()
                        escapeConnection = nil
                    end
                end
            end, "Escape", function(details)
                createInlineSlider(details, "Escape Distance", 5, 30, function() return escapeDistance end, function(v) escapeDistance = v end, "")
            end, {premium = true})
        end
        createBindButton("Noclip", function() return noclipEnabled end, function(v) noclipEnabled = v end, "Noclip")
        createBindButton("Inf Jump", function() return infJumpEnabled end, function(v) infJumpEnabled = v end, "InfJump")
        createBindButton("Speed", function() return speedEnabled end, function(v) speedEnabled = v end, "Speed", function(details)
            createInlineSlider(details, "Walk Speed", 10, 200, function() return speedPower end, function(v) speedPower = v end, "")
            createInlineToggle(details, "Bunny Hop", function() return utilitySettings.bunnyHopEnabled end, function(v) utilitySettings.bunnyHopEnabled = v end)
        end)
        createBindButton("Jump Power", function() return jumpEnabled end, function(v) jumpEnabled = v end, "JumpPower", function(details)
