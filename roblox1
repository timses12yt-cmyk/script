-- Luau/executor chunks can hit the top-level local register cap in large UI scripts.
-- Keep late-stage helpers non-local so the Nursultan-style UI still compiles cleanly.
espObjects = {}

function getPlayerEspAccent(plr)
    if friends[plr.UserId] then
        return colors.friend, Color3.fromRGB(64, 124, 255)
    end
    return colors.accentLight, colors.accent
end

function shouldTrackPlayerEsp(plr)
    if not plr or plr == player or not espEnabled then
        return false
    end
    if espMode == "РџСЂРµРґРјРµС‚С‹" then
        return false
    end
    if espMode == "Р”СЂСѓР·СЊСЏ" then
        return friends[plr.UserId] ~= nil
    end
    return true
end

function clearESPVisuals(entry)
    if not entry then
        return
    end
    if entry.renderConnection then
        entry.renderConnection:Disconnect()
        entry.renderConnection = nil
    end
    for _, obj in ipairs(entry.visuals or {}) do
        pcall(function()
            obj:Destroy()
        end)
    end
    entry.visuals = {}
    entry.character = nil
end

function clearESPPlayer(plr)
    local entry = espObjects[plr]
    if not entry then
        return
    end
    clearESPVisuals(entry)
    if entry.charAddedConnection then
        entry.charAddedConnection:Disconnect()
    end
    if entry.charRemovingConnection then
        entry.charRemovingConnection:Disconnect()
    end
    espObjects[plr] = nil
end

function bindESPCharacter(plr, char)
    local entry = espObjects[plr]
    if not entry or not char then
        return
    end

    clearESPVisuals(entry)

    local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 3)
    local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
    if not head or not root then
        return
    end

    entry.character = char
    entry.visuals = {}

    local accentOutline, accentFill = getPlayerEspAccent(plr)

    local highlight = Instance.new("Highlight")
    highlight.Name = "Nez0xPlayerHighlight"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.82
    highlight.OutlineTransparency = 0.06
