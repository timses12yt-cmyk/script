local function isItemObject(obj)
    if not obj then return false end
    if not obj.Parent then return false end
    
    if obj:IsDescendantOf(player.Character) then return false end
    
    if obj:IsA("Tool") then
        return true
    end
    
    return false
end

local function getItemName(obj)
    local name = obj.Name
    for key, display in pairs(itemNames) do
        if name:lower():find(key:lower()) then
            return display
        end
    end
    if obj:IsA("Tool") then
        return "🔧 " .. name
    end
    return "📦 " .. name
end

local function createItemESP(item)
    if espItems[item] then return end
    
    local bill = Instance.new("BillboardGui")
    bill.Name = "ItemESP"
    bill.Size = UDim2.new(0, 120, 0, 30)
    bill.StudsOffset = Vector3.new(0, 1.5, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = item
    bill.Parent = item
    
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = colors.item
    bg.BackgroundTransparency = 0.3
    bg.Parent = bill
    
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 6)
    bgCorner.Parent = bg
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = getItemName(item)
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = bg
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = colors.item
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(255, 255, 100)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = item
    
    espItems[item] = {billboard = bill, highlight = highlight, label = nameLabel}
end

local function removeItemESP(item)
    local data = espItems[item]
    if data then
        if data.billboard then data.billboard:Destroy() end
        if data.highlight then data.highlight:Destroy() end
        espItems[item] = nil
    end
end

local function updateItemESP()
    for item, _ in pairs(espItems) do
        if not item or not item.Parent then
            removeItemESP(item)
        elseif player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local root = player.Character.HumanoidRootPart
            local dist = (root.Position - item.Position).Magnitude
            local visible = dist <= utilitySettings.espDistance
            local data = espItems[item]
            if data then
                if data.billboard then
                    data.billboard.Enabled = visible
                end
                if data.highlight then
                    data.highlight.Enabled = visible
